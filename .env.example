# PawLink (Next.js) environment — copy to `.env.local` and fill in.
# `.env.local` is gitignored; never commit secrets.

# --- Supabase ---
# Public (safe to expose to the browser):
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only (used in API routes for privileged writes/storage). NEVER expose.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Biometric embedding (CLIP ViT-B-32 via @xenova/transformers) = 512.
# Must match the vector(512) column in lib/db/schema.sql.
EMBEDDING_DIM=512

# --- Vision model ---
# MOCK_VISION=true  -> lib/vision/mock.ts (hardcoded passport, default for now)
# MOCK_VISION=false -> lib/vision/pixtral.ts (Mistral Pixtral; needs MISTRAL_API_KEY)
MOCK_VISION=true
# CLIP image embeddings via @xenova/transformers (needs sharp). Off by default;
# leave false to use the dependency-free deterministic embedding.
USE_CLIP=false
# Vision model name. Must be vision-capable (e.g. pixtral-12b-2409 / a Pixtral model).
MISTRAL_MODEL=pixtral-12b-2409
MISTRAL_API_KEY=

# --- Notifications ---
# "mock" only for now (logs to console, returns fake success).
NOTIFIER_PROVIDER=mock
SHELTER_NAME=PawLink Rescue Shelter
NEXT_PUBLIC_APP_URL=http://localhost:3000
CONFIRM_BASE_URL=http://localhost:3000

# --- Tests (npm test) ---
# Point the e2e test at a throwaway Supabase project (schema applied).
TEST_SUPABASE_URL=
TEST_SUPABASE_SERVICE_ROLE_KEY=
